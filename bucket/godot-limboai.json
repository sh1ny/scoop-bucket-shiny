{
    "version": "1.8.0-godot-4.7",
    "description": "Godot editor build bundled with LimboAI behavior trees and state machines.",
    "homepage": "https://github.com/limbonaut/limboai",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://github.com/limbonaut/limboai/releases/download/v1.8.0/limboai+v1.8.0.godot-4.7.editor.windows.x86_64.zip",
            "hash": "1f2a0069b9b042d0aba135a829c84e5030d151b8cd4986773bf45f3f72f414ae"
        }
    },
    "pre_install": [
        "$console = Get-ChildItem \"$dir\" -Filter '*.exe' -Recurse | Where-Object { $_.Name -match 'console' } | Select-Object -First 1",
        "if ($console) { Rename-Item $console.FullName 'godot.console.exe' -Force }",
        "$gui = Get-ChildItem \"$dir\" -Filter '*.exe' -Recurse | Where-Object { $_.Name -notmatch 'console' } | Select-Object -First 1",
        "if ($gui) { Rename-Item $gui.FullName 'godot.exe' -Force }",
        "New-Item -Force -Path \"$dir\" -Name '._sc_' -ItemType File | Out-Null"
    ],
    "bin": [
        [
            "godot.console.exe",
            "godot-limboai"
        ]
    ],
    "shortcuts": [
        [
            "godot.exe",
            "Godot LimboAI"
        ]
    ],
    "persist": "editor_data",
    "checkver": {
        "url": "https://api.github.com/repos/limbonaut/limboai/releases/latest",
        "jsonpath": "$.assets[*].name",
        "regex": "limboai\\+v(?<limbo>[\\d.]+)\\.godot-(?<godot>[\\d.]+)\\.editor\\.windows\\.x86_64\\.zip",
        "replace": "${limbo}-godot-${godot}"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/limbonaut/limboai/releases/download/v$matchLimbo/limboai+v$matchLimbo.godot-$matchGodot.editor.windows.x86_64.zip"
            }
        },
        "hash": {
            "mode": "json",
            "url": "https://api.github.com/repos/limbonaut/limboai/releases/tags/v$matchLimbo",
            "jsonpath": "$.assets[?(@.name == 'limboai+v$matchLimbo.godot-$matchGodot.editor.windows.x86_64.zip')].digest"
        }
    }
}
